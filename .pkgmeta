# What the BigWigs packager puts in the release zip (.github/workflows/release.yml).
# Files starting with a dot (.github, .pkgmeta) are left out on their own.
package-as: GamepadReticleOnTarget

# Comments only on their own line: the packager reads anything after an item as part of it.
ignore:
  - tests
  # /grt debug, the in-game test suite; its .toc line is in a do-not-package block
  - Debug.lua
  # the icon's source and its CurseForge size; the game uses Media/icon-64.png
  - Media/icon.svg
  - Media/icon-400.png
